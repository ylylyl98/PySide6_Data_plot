/* DPTK Desktop application QSS.
   Rendered at runtime from semantic Fluent aliases; do not hardcode resolved
   theme values here. Minimum control content heights exclude padding and the
   border: 22 + 6/8 + 2 gives a 30/32 px desktop target. */

QWidget {
    color: @{text_primary};
    selection-background-color: @{selection_strong_background};
    selection-color: @{selection_strong_foreground};
}

QMainWindow, QDialog {
    background-color: @{window_background};
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QLabel {
    background-color: transparent;
}

/* ---- Text hierarchy ---- */
QLabel[appRole="pageHeading"] {
    color: @{heading_text};
    font-size: @{font_subtitle1_size};
    font-weight: @{weight_semibold};
}

QLabel[appRole="hintText"] {
    color: @{text_secondary};
    font-size: @{font_caption1_size};
}

QLabel[appRole="stepBanner"] {
    background-color: @{brand_background_subtle};
    color: @{text_secondary};
    border: none;
    border-left: @{stroke_thick} solid @{brand_border};
    border-radius: @{radius_medium};
    padding: @{space_s} @{space_m};
    font-size: @{font_caption1_size};
}

QLabel[appRole="regionTitle"],
QLabel[appRole="dockSectionTitle"] {
    color: @{heading_text};
    font-size: @{font_body_size};
    font-weight: @{weight_semibold};
}

QLabel[appRole="sectionLabel"] {
    color: @{section_text};
    font-weight: @{weight_semibold};
}

QLabel[appRole="fitStatus"] {
    color: @{brand_foreground};
    font-size: @{font_caption2_size};
}

QLabel[appRole="sourceState"] {
    background-color: @{info_background};
    color: @{info_foreground};
    border: @{stroke_thin} solid @{info_border};
    border-radius: @{radius_large};
    padding: @{space_s} @{space_m};
    font-size: @{font_caption1_size};
}

QLabel[appRole="sourceState"][fluentSeverity="warning"] {
    background-color: @{warning_background};
    color: @{warning_foreground};
    border-color: @{warning_border};
}

QLabel[appRole="sourceState"][fluentSeverity="danger"] {
    background-color: @{danger_background};
    color: @{danger_foreground};
    border-color: @{danger_border};
}

/* ---- Status badges ---- */
QLabel[appRole="sourceBadge"] {
    background-color: @{source_new_background};
    border: @{stroke_thin} solid @{source_new_border};
    border-radius: @{radius_small};
    color: @{source_new_foreground};
    padding: 5px 8px;
    font-weight: @{weight_semibold};
}

QLabel[appRole="sourceBadge"][badgeState="processed"] {
    background-color: @{source_processed_background};
    border-color: @{source_processed_border};
    color: @{source_processed_foreground};
}

QLabel[appRole="sourceBadge"][badgeState="saved"] {
    background-color: @{source_saved_background};
    border-color: @{source_saved_border};
    color: @{source_saved_foreground};
}

QLabel[appRole="statusBadge"] {
    background-color: @{info_background};
    border: @{stroke_thin} solid @{info_border};
    border-radius: @{radius_small};
    color: @{info_foreground};
    padding: 4px 6px;
    font-weight: @{weight_semibold};
}

QLabel[appRole="statusBadge"][fluentSeverity="success"] {
    background-color: @{success_background};
    border-color: @{success_border};
    color: @{success_foreground};
}

QLabel[appRole="statusBadge"][fluentSeverity="warning"] {
    background-color: @{warning_background};
    border-color: @{warning_border};
    color: @{warning_foreground};
}

QLabel[appRole="statusBadge"][fluentSeverity="danger"] {
    background-color: @{danger_background};
    border-color: @{danger_border};
    color: @{danger_foreground};
}

/* ---- Buttons ---- */
QPushButton, QToolButton {
    background-color: @{control_surface};
    color: @{text_primary};
    border: @{stroke_thin} solid @{border_primary};
    border-radius: @{radius_large};
    min-height: 22px;
    padding: @{space_xs} @{space_m};
    font-weight: @{weight_semibold};
}

QPushButton:hover, QToolButton:hover {
    background-color: @{surface_background_hover};
    border-color: @{border_hover};
}

QPushButton:pressed, QToolButton:pressed {
    background-color: @{surface_background_pressed};
    border-color: @{border_pressed};
}

QPushButton:focus, QToolButton:focus,
QPushButton:default {
    border: @{stroke_thin} solid @{focus_border};
}

QPushButton:disabled, QToolButton:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
    color: @{text_disabled};
}

QToolButton:checked {
    background-color: @{brand_background_subtle};
    border-color: @{brand_border};
    color: @{brand_foreground};
}

QToolButton:checked:hover {
    background-color: @{brand_background_subtle_hover};
}

QToolButton:checked:pressed {
    background-color: @{brand_background_subtle_pressed};
}

QToolButton[autoRaise="true"] {
    background-color: transparent;
    border: @{stroke_thin} solid transparent;
}

QToolButton[autoRaise="true"]:hover {
    background-color: @{subtle_hover};
    border-color: @{border_subtle};
}

QToolButton[autoRaise="true"]:checked {
    background-color: @{brand_background_subtle};
    border-color: @{brand_border};
    color: @{brand_foreground};
}

QToolButton[autoRaise="true"]:focus {
    border-color: @{focus_border};
}

QToolButton[fluentIconOnly="true"] {
    padding: @{space_xs};
    min-width: @{icon_size_medium};
}

QPushButton[fluentAppearance="primary"], QToolButton[fluentAppearance="primary"],
QToolButton[appRole="toolbarPrimaryAction"] {
    background-color: @{brand_background};
    color: @{text_on_brand};
    border-color: transparent;
}

QPushButton[fluentAppearance="primary"]:hover, QToolButton[fluentAppearance="primary"]:hover,
QToolButton[appRole="toolbarPrimaryAction"]:hover {
    background-color: @{brand_background_hover};
}

QPushButton[fluentAppearance="primary"]:pressed, QToolButton[fluentAppearance="primary"]:pressed,
QToolButton[appRole="toolbarPrimaryAction"]:pressed {
    background-color: @{brand_background_pressed};
}

QPushButton[fluentAppearance="primary"]:focus, QToolButton[fluentAppearance="primary"]:focus,
QToolButton[appRole="toolbarPrimaryAction"]:focus {
    border: @{stroke_thick} solid @{focus_inner};
    padding: 3px 11px;
}

QPushButton[fluentAppearance="primary"]:disabled, QToolButton[fluentAppearance="primary"]:disabled,
QToolButton[appRole="toolbarPrimaryAction"]:disabled {
    background-color: @{surface_disabled};
    color: @{text_disabled};
    border-color: @{border_disabled};
}

QPushButton[fluentAppearance="subtle"], QToolButton[fluentAppearance="subtle"],
QPushButton[fluentAppearance="transparent"], QToolButton[fluentAppearance="transparent"],
QToolButton[appRole="toolbarSecondaryAction"] {
    background-color: transparent;
    border-color: transparent;
    color: @{text_secondary};
    font-weight: @{weight_regular};
}

QPushButton[fluentAppearance="subtle"]:hover, QToolButton[fluentAppearance="subtle"]:hover,
QPushButton[fluentAppearance="transparent"]:hover, QToolButton[fluentAppearance="transparent"]:hover,
QToolButton[appRole="toolbarSecondaryAction"]:hover {
    background-color: @{subtle_hover};
    color: @{text_primary};
}

QPushButton[fluentAppearance="subtle"]:pressed, QToolButton[fluentAppearance="subtle"]:pressed,
QPushButton[fluentAppearance="transparent"]:pressed, QToolButton[fluentAppearance="transparent"]:pressed,
QToolButton[appRole="toolbarSecondaryAction"]:pressed {
    background-color: @{subtle_pressed};
}

QPushButton[fluentAppearance="subtle"]:focus, QToolButton[fluentAppearance="subtle"]:focus,
QPushButton[fluentAppearance="transparent"]:focus, QToolButton[fluentAppearance="transparent"]:focus,
QToolButton[appRole="toolbarSecondaryAction"]:focus {
    border-color: @{focus_border};
}

QPushButton[fluentAppearance="subtle"]:disabled, QToolButton[fluentAppearance="subtle"]:disabled,
QPushButton[fluentAppearance="transparent"]:disabled, QToolButton[fluentAppearance="transparent"]:disabled,
QToolButton[appRole="toolbarSecondaryAction"]:disabled {
    background-color: transparent;
    color: @{text_disabled};
    border-color: transparent;
}

QToolButton:checked:disabled,
QToolButton[autoRaise="true"]:checked:disabled {
    background-color: @{surface_disabled};
    color: @{text_disabled};
    border-color: @{border_disabled};
}

QPushButton[fluentAppearance="danger"], QToolButton[fluentAppearance="danger"] {
    background-color: @{danger_background_strong};
    border-color: transparent;
    color: @{text_on_brand};
}

QPushButton[fluentAppearance="danger"]:hover, QToolButton[fluentAppearance="danger"]:hover {
    background-color: @{danger_background_strong_hover};
}

QPushButton[fluentAppearance="danger"]:pressed, QToolButton[fluentAppearance="danger"]:pressed {
    background-color: @{danger_background_strong_pressed};
}

QPushButton[fluentAppearance="danger"]:focus, QToolButton[fluentAppearance="danger"]:focus {
    border-color: @{focus_border};
}

QPushButton[fluentAppearance="danger"]:disabled, QToolButton[fluentAppearance="danger"]:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
    color: @{text_disabled};
}

QPushButton[fluentBusy="true"], QToolButton[fluentBusy="true"] {
    background-color: @{brand_background_subtle};
    border-color: @{brand_border_subtle};
    color: @{brand_foreground};
}

QPushButton[fluentBusy="true"]:focus, QToolButton[fluentBusy="true"]:focus {
    border-color: @{focus_border};
}

QPushButton[fluentSize="compact"], QToolButton[fluentSize="compact"],
QWidget[fluentSize="compact"] QPushButton, QWidget[fluentSize="compact"] QToolButton {
    min-height: 18px;
    padding: 2px @{space_s};
}

QPushButton[appRole="linkButton"] {
    background-color: transparent;
    border: none;
    color: @{brand_foreground};
    font-weight: @{weight_semibold};
}

QPushButton[appRole="linkButton"]:hover {
    background-color: @{subtle_hover};
}

QPushButton[appRole="linkButton"]:focus {
    border: @{stroke_thin} solid @{focus_border};
    border-radius: @{radius_small};
}

QToolButton[appRole="expanderHead"] {
    background-color: transparent;
    border: none;
    padding: @{space_xs} 0;
    min-height: 24px;
    color: @{text_primary};
    font-size: @{font_body_size};
    font-weight: @{weight_semibold};
    text-align: left;
}

QToolButton[appRole="expanderHead"]:hover {
    background-color: transparent;
    color: @{brand_foreground};
}

QToolButton[appRole="expanderHead"]:focus {
    border: @{stroke_thin} solid @{focus_border};
    border-radius: @{radius_small};
}

/* ---- Inputs ---- */
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: @{control_surface};
    color: @{text_primary};
    border: @{stroke_thin} solid @{border_primary};
    border-radius: @{radius_large};
    min-height: 22px;
    padding: 3px @{space_s};
    selection-background-color: @{selection_strong_background};
    selection-color: @{selection_strong_foreground};
}

QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: @{border_hover};
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: @{focus_border};
    border-bottom: @{stroke_thick} solid @{focus_border};
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
    color: @{text_disabled};
}

QLineEdit:read-only, QPlainTextEdit:read-only, QTextEdit:read-only {
    background-color: @{surface_secondary};
    color: @{text_secondary};
}

QSpinBox[readOnly="true"], QDoubleSpinBox[readOnly="true"] {
    background-color: @{surface_secondary};
    color: @{text_secondary};
}

QLineEdit[fluentInvalid="true"], QPlainTextEdit[fluentInvalid="true"], QTextEdit[fluentInvalid="true"],
QComboBox[fluentInvalid="true"], QSpinBox[fluentInvalid="true"], QDoubleSpinBox[fluentInvalid="true"] {
    border-color: @{danger_foreground};
}

QLineEdit[fluentInvalid="true"]:focus, QPlainTextEdit[fluentInvalid="true"]:focus,
QTextEdit[fluentInvalid="true"]:focus, QComboBox[fluentInvalid="true"]:focus,
QSpinBox[fluentInvalid="true"]:focus, QDoubleSpinBox[fluentInvalid="true"]:focus {
    border-bottom-color: @{focus_border};
}

QLineEdit[fluentInvalid="true"]:disabled, QPlainTextEdit[fluentInvalid="true"]:disabled,
QTextEdit[fluentInvalid="true"]:disabled, QComboBox[fluentInvalid="true"]:disabled,
QSpinBox[fluentInvalid="true"]:disabled, QDoubleSpinBox[fluentInvalid="true"]:disabled {
    border-color: @{border_disabled};
}

QLineEdit[appRole="dropTarget"] {
    background-color: @{brand_background_subtle};
    border: @{stroke_thin} solid @{brand_border};
}

/* ---- Plot empty state (covers only the shell's empty presentation) ---- */
QLabel[appRole="emptyCanvas"] {
    background-color: @{workspace_surface};
    color: @{text_secondary};
    border: none;
    border-radius: @{radius_large};
    padding: @{space_l} @{space_xl};
    font-size: @{font_body_size};
}

/* ---- Fluent spin-box steppers ---- */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    right: 1px;
    width: 20px;
    height: 14px;
    border: none;
    background-color: transparent;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("@{spin_up_icon_disabled}");
    width: @{icon_size_small};
    height: @{icon_size_small};
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("@{spin_down_icon_disabled}");
    width: @{icon_size_small};
    height: @{icon_size_small};
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: @{subtle_hover};
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: @{subtle_pressed};
}

QSpinBox::up-button:focus, QDoubleSpinBox::up-button:focus,
QSpinBox::down-button:focus, QDoubleSpinBox::down-button:focus {
    background-color: @{brand_background_subtle};
}

QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url("@{spin_up_icon_interactive}");
}

QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url("@{spin_down_icon_interactive}");
}

QSpinBox::up-arrow:pressed, QDoubleSpinBox::up-arrow:pressed {
    image: url("@{spin_up_icon_interactive}");
}

QSpinBox::down-arrow:pressed, QDoubleSpinBox::down-arrow:pressed {
    image: url("@{spin_down_icon_interactive}");
}

QSpinBox::up-arrow:focus, QDoubleSpinBox::up-arrow:focus {
    image: url("@{spin_up_icon_interactive}");
}

QSpinBox::down-arrow:focus, QDoubleSpinBox::down-arrow:focus {
    image: url("@{spin_down_icon_interactive}");
}

QSpinBox::up-button:disabled, QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled, QDoubleSpinBox::down-button:disabled,
QSpinBox:disabled::up-button, QDoubleSpinBox:disabled::up-button,
QSpinBox:disabled::down-button, QDoubleSpinBox:disabled::down-button {
    background-color: transparent;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url("@{spin_up_icon_disabled}");
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url("@{spin_down_icon_disabled}");
}

QSpinBox[readOnly="true"]::up-button, QDoubleSpinBox[readOnly="true"]::up-button,
QSpinBox[readOnly="true"]::down-button, QDoubleSpinBox[readOnly="true"]::down-button {
    background-color: transparent;
}

QSpinBox[readOnly="true"]::up-arrow, QDoubleSpinBox[readOnly="true"]::up-arrow {
    image: url("@{spin_up_icon_disabled}");
}

QSpinBox[readOnly="true"]::down-arrow, QDoubleSpinBox[readOnly="true"]::down-arrow {
    image: url("@{spin_down_icon_disabled}");
}

/* Keep numeric text clear of the dedicated stepper hit target. */
QSpinBox, QDoubleSpinBox {
    padding: 3px 4px 3px @{space_s};
}

QLineEdit[fluentSize="compact"], QComboBox[fluentSize="compact"],
QSpinBox[fluentSize="compact"], QDoubleSpinBox[fluentSize="compact"],
QWidget[fluentSize="compact"] QLineEdit, QWidget[fluentSize="compact"] QComboBox,
QWidget[fluentSize="compact"] QSpinBox, QWidget[fluentSize="compact"] QDoubleSpinBox {
    min-height: 18px;
    padding-top: 2px;
    padding-bottom: 2px;
}

QSpinBox[fluentSize="compact"]::up-button, QDoubleSpinBox[fluentSize="compact"]::up-button,
QSpinBox[fluentSize="compact"]::down-button, QDoubleSpinBox[fluentSize="compact"]::down-button,
QWidget[fluentSize="compact"] QSpinBox::up-button, QWidget[fluentSize="compact"] QDoubleSpinBox::up-button,
QWidget[fluentSize="compact"] QSpinBox::down-button, QWidget[fluentSize="compact"] QDoubleSpinBox::down-button {
    height: 11px;
}

QSpinBox[readOnly="true"]::up-button:hover, QDoubleSpinBox[readOnly="true"]::up-button:hover,
QSpinBox[readOnly="true"]::down-button:hover, QDoubleSpinBox[readOnly="true"]::down-button:hover {
    background-color: transparent;
}

QSpinBox[readOnly="true"]::up-button:pressed, QDoubleSpinBox[readOnly="true"]::up-button:pressed,
QSpinBox[readOnly="true"]::down-button:pressed, QDoubleSpinBox[readOnly="true"]::down-button:pressed {
    background-color: transparent;
}

QSpinBox[readOnly="true"]::up-button:focus, QDoubleSpinBox[readOnly="true"]::up-button:focus,
QSpinBox[readOnly="true"]::down-button:focus, QDoubleSpinBox[readOnly="true"]::down-button:focus {
    background-color: transparent;
}

QSpinBox[readOnly="true"]::up-arrow:hover, QDoubleSpinBox[readOnly="true"]::up-arrow:hover,
QSpinBox[readOnly="true"]::up-arrow:pressed, QDoubleSpinBox[readOnly="true"]::up-arrow:pressed,
QSpinBox[readOnly="true"]::up-arrow:focus, QDoubleSpinBox[readOnly="true"]::up-arrow:focus {
    image: url("@{spin_up_icon_disabled}");
}

QSpinBox[readOnly="true"]::down-arrow:hover, QDoubleSpinBox[readOnly="true"]::down-arrow:hover,
QSpinBox[readOnly="true"]::down-arrow:pressed, QDoubleSpinBox[readOnly="true"]::down-arrow:pressed,
QSpinBox[readOnly="true"]::down-arrow:focus, QDoubleSpinBox[readOnly="true"]::down-arrow:focus {
    image: url("@{spin_down_icon_disabled}");
}

QSpinBox[fluentInvalid="true"]::up-button, QDoubleSpinBox[fluentInvalid="true"]::up-button,
QSpinBox[fluentInvalid="true"]::down-button, QDoubleSpinBox[fluentInvalid="true"]::down-button {
    background-color: transparent;
}

QComboBox::drop-down {
    border: none;
    width: @{control_height_small};
}

QComboBox:on {
    background-color: @{surface_background_pressed};
    border-color: @{brand_border};
}

QComboBox::down-arrow {
    image: url("@{combo_arrow_icon}");
    width: @{icon_size_small};
    height: @{icon_size_small};
}

QComboBox::down-arrow:hover,
QComboBox::down-arrow:on {
    image: url("@{combo_arrow_icon_interactive}");
}

QComboBox::down-arrow:disabled {
    image: url("@{combo_arrow_icon_disabled}");
}

QComboBox QAbstractItemView {
    background-color: @{surface_elevated};
    border: @{stroke_thin} solid @{border_primary};
    selection-background-color: @{selection_strong_background};
    selection-color: @{selection_strong_foreground};
    padding: @{space_xs};
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: @{space_xs} @{space_s};
}

/* ---- Selection controls ---- */
QCheckBox, QRadioButton {
    color: @{text_primary};
    spacing: @{space_s};
    background-color: transparent;
    border: @{stroke_thin} solid transparent;
    border-radius: @{radius_medium};
    padding: 2px 0;
}

QCheckBox:focus, QRadioButton:focus {
    border-color: @{focus_border};
}

QCheckBox:disabled, QRadioButton:disabled {
    color: @{text_disabled};
}

QCheckBox::indicator {
    width: @{icon_size_small};
    height: @{icon_size_small};
    border: @{stroke_thin} solid @{border_primary};
    border-radius: @{radius_small};
    background-color: @{surface_background};
}

QCheckBox::indicator:hover {
    border-color: @{brand_border};
}

QCheckBox::indicator:pressed {
    background-color: @{subtle_pressed};
    border-color: @{brand_border};
}

QCheckBox::indicator:focus {
    border: @{stroke_thin} solid @{focus_border};
}

QCheckBox::indicator:checked {
    background-color: @{brand_background};
    border-color: @{brand_background};
    image: url("@{checkbox_checked_icon}");
    width: @{icon_size_small};
    height: @{icon_size_small};
}

QCheckBox::indicator:checked:hover {
    background-color: @{brand_background_hover};
    border-color: @{brand_background_hover};
}

QCheckBox::indicator:checked:pressed {
    background-color: @{brand_background_pressed};
    border-color: @{brand_background_pressed};
}

QCheckBox::indicator:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
}

QCheckBox::indicator:checked:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
    image: url("@{checkbox_checked_icon_disabled}");
}

QCheckBox::indicator:indeterminate {
    width: @{space_m_nudge};
    height: @{space_m_nudge};
    background-color: @{brand_background_subtle};
    border: 4px solid @{brand_border};
}

QCheckBox::indicator:indeterminate:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
}

QRadioButton::indicator {
    width: @{icon_size_small};
    height: @{icon_size_small};
    border: @{stroke_thin} solid @{border_primary};
    border-radius: @{space_s};
    background-color: @{control_surface};
}

QRadioButton::indicator:hover {
    border-color: @{brand_border};
}

QRadioButton::indicator:pressed {
    background-color: @{subtle_pressed};
}

QRadioButton::indicator:checked {
    width: @{space_s};
    height: @{space_s};
    background-color: @{control_surface};
    border: 5px solid @{brand_background};
}

QRadioButton::indicator:checked:hover {
    border-color: @{brand_background_hover};
}

QRadioButton::indicator:checked:pressed {
    border-color: @{brand_background_pressed};
}

QRadioButton::indicator:disabled {
    background-color: @{surface_disabled};
    border-color: @{border_disabled};
}

QRadioButton::indicator:checked:disabled {
    border-color: @{border_disabled};
}

/* ---- Groups, cards, dividers ---- */
QGroupBox {
    background-color: transparent;
    border: none;
    border-top: @{stroke_thin} solid @{border_subtle};
    border-radius: 0;
    margin-top: @{space_xl};
    padding: @{space_m} 0 @{space_xs} 0;
    font-weight: @{weight_semibold};
    font-size: @{font_body_size};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 0 @{space_s} 0 0;
    color: @{heading_text};
}

QGroupBox:disabled, QGroupBox::title:disabled {
    color: @{text_disabled};
}

QFrame[fluentRole="card"] {
    background-color: @{card_background};
    border: @{stroke_thin} solid @{border_subtle};
    border-radius: @{radius_large};
}

QFrame[fluentRole="divider"] {
    background-color: @{border_subtle};
    border: none;
    min-height: @{stroke_thin};
    max-height: @{stroke_thin};
}

QFrame[fluentRole="panel"] {
    background-color: @{shell_panel_background};
    border: none;
    border-top: @{stroke_thin} solid @{shell_panel_border};
    border-bottom: @{stroke_thin} solid @{shell_panel_border};
}

QFrame[fluentRole="messageBar"] {
    background-color: @{info_background};
    border: @{stroke_thin} solid @{info_border};
    border-radius: @{radius_medium};
    color: @{info_foreground};
}

QFrame[fluentRole="messageBar"][fluentSeverity="success"] {
    background-color: @{success_background};
    border-color: @{success_border};
    color: @{success_foreground};
}

QFrame[fluentRole="messageBar"][fluentSeverity="warning"] {
    background-color: @{warning_background};
    border-color: @{warning_border};
    color: @{warning_foreground};
}

QFrame[fluentRole="messageBar"][fluentSeverity="danger"] {
    background-color: @{danger_background};
    border-color: @{danger_border};
    color: @{danger_foreground};
}

/* ---- Workflow navigation ---- */
QFrame#workflowNavigation,
QFrame[appRole="workflowRail"] {
    background-color: @{chrome_surface};
    border: none;
    border-right: @{stroke_thin} solid @{chrome_border};
    border-radius: 0;
}

QLabel[appRole="workflowRailTitle"] {
    color: @{heading_text};
    font-size: @{font_body2_size};
    font-weight: @{weight_semibold};
    padding: @{space_s} 0;
}

QLabel[appRole="workflowUtilityLabel"] {
    color: @{text_tertiary};
    font-size: @{font_caption1_size};
    padding: @{space_xs} 0;
}

QToolButton[appRole="workflowDestination"] {
    background-color: transparent;
    border: @{stroke_thin} solid transparent;
    border-left: 3px solid transparent;
    border-radius: @{radius_large};
    color: @{chrome_foreground};
    min-height: 26px;
    padding: @{space_s_nudge} @{space_s_nudge};
    font-size: @{font_caption1_size};
    font-weight: @{weight_regular};
    text-align: left;
}

QToolButton[appRole="workflowDestination"]:hover {
    background-color: @{subtle_hover};
    color: @{heading_text};
}

QToolButton[appRole="workflowDestination"]:pressed {
    background-color: @{subtle_pressed};
}

QToolButton[appRole="workflowDestination"]:checked {
    background-color: @{active_nav_background};
    border-left-color: @{brand_border};
    color: @{active_nav_foreground};
    font-weight: @{weight_semibold};
}

QToolButton[appRole="workflowDestination"]:checked:hover {
    background-color: @{brand_background_subtle_hover};
}

QToolButton[appRole="workflowDestination"]:checked:pressed {
    background-color: @{brand_background_subtle_pressed};
}

QToolButton[appRole="workflowDestination"]:focus,
QToolButton[appRole="workflowDestination"]:checked:focus {
    border-color: @{focus_border};
}

QToolButton[appRole="workflowDestination"]:disabled {
    background-color: transparent;
    color: @{text_disabled};
    border-color: transparent;
}

QFrame#workflowNavigation QTabBar::tab {
    min-width: 76px;
    padding: 7px 13px;
    border: none;
    color: @{text_secondary};
}

QFrame#workflowNavigation QTabBar::tab:selected {
    color: @{brand_foreground};
    font-weight: @{weight_semibold};
    border-bottom: 2px solid @{brand_border};
}

QFrame#workflowNavigation QTabBar::tab:hover {
    color: @{brand_foreground};
}

QFrame#workflowNavigation QTabBar::tab:focus {
    color: @{brand_foreground};
}

QFrame#workflowNavigation QFrame#workflowUtilitySeparator[fluentRole="divider"] {
    background-color: @{border_subtle};
    border: none;
    min-width: 0;
    max-width: 16777215px;
    min-height: @{stroke_thin};
    max-height: @{stroke_thin};
}

QToolButton[appRole="sidebarToggle"] {
    min-height: 28px;
    padding: 3px 8px;
    border-radius: @{radius_medium};
    background-color: transparent;
    border-color: transparent;
}

QToolButton[appRole="sidebarToggle"]:hover {
    background-color: @{subtle_hover};
    border-color: @{border_subtle};
}

QToolButton[appRole="sidebarToggle"]:checked {
    background-color: @{brand_background_subtle};
    border-color: @{brand_border};
}

QToolButton[appRole="sidebarToggle"]:focus {
    border: @{stroke_thin} solid @{focus_border};
}

QToolButton[appRole="sidebarToggle"]:pressed {
    background-color: @{subtle_pressed};
}

QToolButton[appRole="sidebarToggle"]:disabled {
    color: @{text_disabled};
    background-color: transparent;
    border-color: transparent;
}

/* ---- Workspace hierarchy ---- */
QFrame[appRole="workspaceHeader"] {
    background-color: @{workspace_surface};
    border: none;
    border-bottom: @{stroke_thin} solid @{chrome_border};
}

QLabel[appRole="workspaceEyebrow"] {
    color: @{brand_foreground};
    font-size: @{font_caption1_size};
    font-weight: @{weight_semibold};
}

QLabel[appRole="workspaceTitle"] {
    color: @{heading_text};
    font-size: @{font_subtitle1_size};
    font-weight: @{weight_semibold};
}

QLabel[appRole="workspaceSubtitle"] {
    color: @{section_text};
    font-size: @{font_caption1_size};
}

QWidget[appRole="workspaceCanvas"],
QWidget[appRole="plotSurface"] {
    background-color: @{workspace_surface};
    border: none;
}

QWidget[appRole="controlSidebar"],
QWidget[appRole="controlsSidebar"] {
    background-color: @{sidebar_surface};
    border: none;
    border-right: @{stroke_thin} solid @{chrome_border};
}

QWidget[appRole="plotCommandBar"] {
    background-color: @{sidebar_surface};
    border: none;
    border-bottom: @{stroke_thin} solid @{chrome_border};
}

QLabel[appRole="toolbarSectionLabel"] {
    color: @{text_tertiary};
    font-size: @{font_caption1_size};
    font-weight: @{weight_semibold};
    padding: 0 @{space_xs};
}

QLabel[appRole="busyStatus"] {
    color: @{brand_foreground};
    background-color: @{brand_background_subtle};
    border: @{stroke_thin} solid @{brand_border_subtle};
    border-radius: @{radius_medium};
    padding: @{space_xs} @{space_s};
    font-weight: @{weight_semibold};
}

/* ---- Tabs ---- */
QTabWidget::pane {
    background-color: @{canvas_background};
    border: @{stroke_thin} solid @{border_subtle};
    border-radius: @{radius_large};
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: @{stroke_thick} solid transparent;
    color: @{text_secondary};
    padding: @{space_s} @{space_m};
    font-weight: @{weight_regular};
}

QTabBar::tab:hover {
    background-color: @{subtle_hover};
    color: @{text_primary};
}

QTabBar::tab:selected {
    background-color: @{workspace_surface};
    color: @{text_primary};
    border-bottom-color: @{brand_background};
    font-weight: @{weight_semibold};
}

QTabBar::tab:disabled {
    color: @{text_disabled};
}

QTabBar::tab:focus {
    border: @{stroke_thin} solid @{focus_border};
}

QTabBar::tab:selected:focus {
    border-bottom: @{stroke_thick} solid @{focus_border};
}

/* ---- Item views ---- */
QListWidget, QListView, QTableWidget, QTableView, QTreeWidget, QTreeView {
    background-color: @{canvas_background};
    color: @{text_primary};
    border: @{stroke_thin} solid @{border_subtle};
    border-radius: @{radius_medium};
    selection-background-color: @{selection_strong_background};
    selection-color: @{selection_strong_foreground};
    alternate-background-color: @{surface_secondary};
    gridline-color: @{border_tertiary};
}

QListWidget::item, QListView::item, QTreeWidget::item, QTreeView::item {
    padding: @{space_xs} @{space_s};
    border: none;
}

QListWidget::item:hover:!selected, QListView::item:hover:!selected,
QTreeWidget::item:hover:!selected, QTreeView::item:hover:!selected,
QTableWidget::item:hover:!selected, QTableView::item:hover:!selected {
    background-color: @{subtle_hover};
}

/* Pair the delegate's selected text with the same strong selection surface. */
QListWidget::item:selected, QListView::item:selected,
QTableWidget::item:selected, QTableView::item:selected,
QTreeWidget::item:selected, QTreeView::item:selected,
QListWidget::item:selected:hover, QListView::item:selected:hover,
QTableWidget::item:selected:hover, QTableView::item:selected:hover,
QTreeWidget::item:selected:hover, QTreeView::item:selected:hover {
    background-color: @{selection_strong_background};
    color: @{selection_strong_foreground};
}

QListWidget:focus, QListView:focus, QTableWidget:focus, QTableView:focus,
QTreeWidget:focus, QTreeView:focus {
    border-color: @{focus_border};
}

QListWidget:disabled, QListView:disabled, QTableWidget:disabled, QTableView:disabled,
QTreeWidget:disabled, QTreeView:disabled {
    background-color: @{surface_disabled};
    color: @{text_disabled};
    border-color: @{border_disabled};
}

QListWidget::item:disabled, QListView::item:disabled,
QTableWidget::item:disabled, QTableView::item:disabled,
QTreeWidget::item:disabled, QTreeView::item:disabled {
    color: @{text_disabled};
}

QHeaderView::section {
    background-color: @{surface_secondary};
    color: @{text_secondary};
    border: none;
    border-bottom: @{stroke_thin} solid @{border_subtle};
    padding: @{space_s} @{space_m};
    font-weight: @{weight_semibold};
}

/* ---- Status bar ---- */
QStatusBar {
    background-color: @{chrome_surface};
    border-top: @{stroke_thin} solid @{border_subtle};
    color: @{text_secondary};
    font-size: @{font_caption1_size};
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 0 4px;
}

QStatusBar QLabel[appRole="statusItemPassive"] {
    color: @{text_secondary};
}

QStatusBar QLabel[appRole="busyStatus"] {
    padding: 1px @{space_s};
}

QStatusBar QProgressBar {
    min-height: 4px;
    max-height: 6px;
    border: none;
    border-radius: 2px;
}

/* ---- Docks and toolbar ---- */
QDockWidget {
    color: @{text_primary};
    font-weight: @{weight_semibold};
}

QDockWidget::title {
    background-color: @{surface_secondary};
    border-bottom: @{stroke_thin} solid @{border_subtle};
    padding: @{space_s} @{space_m};
    font-size: @{font_caption1_size};
}

QToolBar {
    background-color: @{workspace_surface};
    border-bottom: @{stroke_thin} solid @{border_subtle};
    spacing: @{space_s};
    /* Qt uses the largest padding edge as PM_ToolBarFrameWidth, applying it
       on every side of the native toolbar layout. Keep this uniform so a
       horizontal gutter cannot inflate the command bar's vertical height. */
    padding: @{space_xxs};
}

QToolBar#mainToolbar {
    spacing: @{space_xs};
    padding: @{space_xxs};
}

QToolBar#panelsToolbar {
    background-color: @{surface_secondary};
    border-top: @{stroke_thin} solid @{border_subtle};
    border-bottom: none;
    spacing: @{space_xs};
    padding: @{space_xxs};
}

QToolBar#panelsToolbar QToolButton {
    min-height: 26px;
    padding: 2px @{space_s};
    border-radius: @{radius_medium};
    background-color: transparent;
    border-color: transparent;
}

QToolBar#panelsToolbar QToolButton:hover {
    background-color: @{subtle_hover};
    border-color: @{border_subtle};
}

QToolBar#panelsToolbar QToolButton:checked {
    background-color: @{brand_background_subtle};
    border-color: @{brand_border};
}

QToolBar#panelsToolbar QToolButton[appRole="panelSelector"]:focus {
    border: @{stroke_thin} solid @{focus_border};
}

QToolBar::separator {
    width: 1px;
    background-color: @{border_subtle};
    margin: 4px 6px;
}

/* ---- Progress ---- */
QProgressBar {
    background-color: @{surface_secondary};
    color: @{text_primary};
    border: @{stroke_thin} solid @{border_primary};
    border-radius: @{radius_medium};
    text-align: center;
    min-height: 14px;
    max-height: 14px;
}

QProgressBar::chunk {
    background-color: @{brand_background};
    border-radius: @{radius_medium};
}

/* ---- Scrollbars (handle uses an accessible stroke for 3:1 contrast) ---- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @{border_accessible};
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: @{text_secondary};
}

QScrollBar::handle:vertical:pressed {
    background-color: @{text_primary};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background-color: transparent;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: @{border_accessible};
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @{text_secondary};
}

QScrollBar::handle:horizontal:pressed {
    background-color: @{text_primary};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0;
    background-color: transparent;
}

/* ---- Splitter ---- */
QSplitter::handle {
    background-color: @{workspace_background};
}

QSplitter::handle:hover {
    background-color: @{brand_border_subtle};
}

QSplitter::handle:horizontal {
    width: 4px;
    margin: 0;
}

/* ---- Menus and tooltips ---- */
QMenuBar {
    background-color: @{chrome_surface};
    color: @{text_primary};
}

QMenuBar::item {
    background-color: transparent;
    padding: @{space_s_nudge} @{space_s};
    border-radius: @{radius_small};
}

QMenuBar::item:selected {
    background-color: @{subtle_hover};
}

QMenuBar::item:pressed {
    background-color: @{subtle_pressed};
}

QMenu {
    background-color: @{surface_elevated};
    color: @{text_primary};
    border: @{stroke_thin} solid @{border_primary};
    border-radius: @{radius_medium};
    padding: @{space_xs};
}

QMenu::item {
    padding: @{space_s} @{space_xxl} @{space_s} @{space_m};
    border-radius: @{radius_medium};
}

QMenu::item:selected {
    background-color: @{brand_background_subtle};
    color: @{brand_foreground};
}

QMenu::item:disabled {
    color: @{text_disabled};
}

QMenu::separator {
    height: @{stroke_thin};
    background-color: @{border_subtle};
    margin: 4px 8px;
}

QToolTip {
    background-color: @{tooltip_background};
    color: @{tooltip_foreground};
    border: @{stroke_thin} solid @{border_accessible};
    padding: 4px 6px;
}
